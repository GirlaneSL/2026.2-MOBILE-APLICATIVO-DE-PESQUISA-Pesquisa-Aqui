// use prisma-next

enum CompanySituation {
    ACTIVE
    INACTIVE
}

enum Profile {
  SUPERADMINISTRATOR
  ADMINISTRATOR
  RESEARCHER
}

model Company {
  id                  Int      @id @default(autoincrement())
  legalName           String
  contactInformation  String
  situation           CompanySituation @default(ACTIVE)
  users               User[]
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  profile      Profile
  companyId    Int?
  company      Company?  @relation(fields: [companyId], references: [id])
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}
