// use prisma-next

enum CompanySituation {
    ACTIVE
    INACTIVE
}

enum Profile {
  SUPERADMINISTRATOR
  ADMINISTRATOR
  RESEARCHER
}

enum ResearchStatus {
  DRAFT
  PUBLISHED
  IN_FIELD
  CLOSED
}

enum QuestionType {
  FREE_TEXT
  NUMERIC
  DATE
  TIME
  YES_NO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SCALE_1_5
  PHOTO
  MULTIPLE_PHOTOS
  LOCATION
  AUDIO
}

enum FileKind {
  PHOTO
  AUDIO
}

model Company {
  id                  Int      @id @default(autoincrement())
  legalName           String
  contactInformation  String
  situation           CompanySituation @default(ACTIVE)
  users               User[]
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  profile      Profile
  companyId    Int?
  company      Company?  @relation(fields: [companyId], references: [id])
  researchLinks ResearchResearcher[]
  collections  Collection[] @relation("CollectionResearcher")
  consentsConfirmed Collection[] @relation("CollectionConsentConfirmedBy")
  syncLogs     SyncLog[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Research {
  id             Int      @id @default(autoincrement())
  title          String
  description    String
  objective      String
  startDate      TimestamptzString @default(now())
  endDate        TimestamptzString @default(now())
  targetAudience String
  status         ResearchStatus   @default(DRAFT)
  recordInterview Boolean @default(false)
  companyId      Int
  company        Company  @relation(fields: [companyId], references: [id])
  sections       Section[]
  collections    Collection[]
  questionRules  QuestionRule[]
  researchers    ResearchResearcher[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model Section {
  id         Int      @id @default(autoincrement())
  title      String
  order      Int
  researchId Int
  research   Research   @relation(fields: [researchId], references: [id], onDelete: Cascade)
  questions  Question[]
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
}

model Question {
  id              Int              @id @default(autoincrement())
  statement       String
  type            QuestionType
  helpText        String?
  isRequired      Boolean          @default(false)
  order           Int
  sectionId       Int
  minSelections   Int?
  maxSelections   Int?
  minValue        Int?
  maxValue        Int?
  minDate         String?
  maxDate         String?
  maxLength       Int?
  scaleLeftLabel  String?
  scaleRightLabel String?
  maxFiles        Int?
  maxDuration     Int?
  section         Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options         QuestionOption[]
  answers         Answer[]
  sourceRules     QuestionRule[]   @relation("RuleSource")
  targetRules     QuestionRule[]   @relation("RuleTarget")
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model QuestionOption {
  id          Int      @id @default(autoincrement())
  text        String
  order       Int
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Answer {
  id          Int      @id @default(autoincrement())
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id])
  value       String
  collectionId Int?
  collection  Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt   TimestamptzString @default(now())
}

// Uma coleta = uma entrevista feita por um pesquisador (respostas + consentimento + áudio opcional).
model Collection {
  id                   Int      @id @default(autoincrement())
  researchId           Int
  research             Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  researcherId         Int
  researcher           User     @relation("CollectionResearcher", fields: [researcherId], references: [id])
  deviceId             String?
  clientId             String?
  startedAt            TimestamptzString
  finishedAt           TimestamptzString
  receivedAt           TimestamptzString @default(now())
  consentGiven         Boolean  @default(false)
  consentAt            TimestamptzString?
  consentConfirmedById Int?
  consentConfirmedBy   User?    @relation("CollectionConsentConfirmedBy", fields: [consentConfirmedById], references: [id])
  audioPath            String?
  audioMimeType        String?
  audioSizeBytes       Int?
  audioDurationSeconds Int?
  answers              Answer[]
  files                CollectionFile[]

  // Idempotência da sincronização: o mesmo UUID do aparelho nunca grava duas coletas do mesmo pesquisador.
  @@unique([researcherId, clientId])
}

// Arquivo (foto ou áudio) de uma coleta. Sobe separado das respostas, depois que a coleta chegou.
model CollectionFile {
  id           Int        @id @default(autoincrement())
  collectionId Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  kind         FileKind
  questionId   Int?
  fileName     String
  // Chave única do arquivo na coleta: impede gravar o mesmo arquivo duas vezes.
  // Foto: "<coleta>:PHOTO:<questão>:<nome>". Áudio: "<coleta>:AUDIO".
  fileKey      String     @unique
  mimeType     String
  sizeBytes    Int
  storagePath  String
  createdAt    TimestamptzString @default(now())
}

// Registro de cada envio de lote feito pelo aplicativo (aparelho, horário e resultado por coleta).
model SyncLog {
  id            Int      @id @default(autoincrement())
  researcherId  Int
  researcher    User     @relation(fields: [researcherId], references: [id])
  deviceId      String?
  receivedAt    TimestamptzString @default(now())
  totalCount    Int
  acceptedCount Int
  existingCount Int
  rejectedCount Int
  details       String
}

model ResearchDownload {
  id         Int      @id @default(autoincrement())
  researchId Int
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  deviceId   String
  userId     Int?
  active     Boolean  @default(true)
  createdAt  TimestamptzString @default(now())
}

model ResearchResearcher {
  id         Int      @id @default(autoincrement())
  researchId Int
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  TimestamptzString @default(now())
}

model QuestionRule {
  id               Int      @id @default(autoincrement())
  researchId       Int
  research         Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  sourceQuestionId Int
  sourceQuestion   Question @relation("RuleSource", fields: [sourceQuestionId], references: [id], onDelete: Cascade)
  triggerValue     String
  targetQuestionId Int
  targetQuestion   Question @relation("RuleTarget", fields: [targetQuestionId], references: [id], onDelete: Cascade)
  createdAt        TimestamptzString @default(now())
}
