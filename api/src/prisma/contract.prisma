// use prisma-next

enum CompanySituation {
    ACTIVE
    INACTIVE
}

enum Profile {
  SUPERADMINISTRATOR
  ADMINISTRATOR
  RESEARCHER
}

enum ResearchStatus {
  DRAFT
  PUBLISHED
  IN_FIELD
  CLOSED
}

model Company {
  id                  Int      @id @default(autoincrement())
  legalName           String
  contactInformation  String
  situation           CompanySituation @default(ACTIVE)
  users               User[]
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  profile      Profile
  companyId    Int?
  company      Company?  @relation(fields: [companyId], references: [id])
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Research {
  id             Int      @id @default(autoincrement())
  title          String
  description    String
  objective      String
  startDate      DateTime
  endDate        DateTime
  targetAudience String
  status         ResearchStatus   @default(DRAFT)
  companyId      Int
  company        Company  @relation(fields: [companyId], references: [id])
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}