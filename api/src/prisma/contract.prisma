// use prisma-next

enum CompanySituation {
    ACTIVE
    INACTIVE
}

enum Profile {
  SUPERADMINISTRATOR
  ADMINISTRATOR
  RESEARCHER
}

enum ResearchStatus {
  DRAFT
  PUBLISHED
  IN_FIELD
  CLOSED
}

enum QuestionType {
  FREE_TEXT
  NUMERIC
  DATE
  TIME
  YES_NO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SCALE_1_5
  PHOTO
  MULTIPLE_PHOTOS
  LOCATION
  AUDIO
}

model Company {
  id                  Int      @id @default(autoincrement())
  legalName           String
  contactInformation  String
  situation           CompanySituation @default(ACTIVE)
  users               User[]
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  profile      Profile
  companyId    Int?
  company      Company?  @relation(fields: [companyId], references: [id])
  researchLinks ResearchResearcher[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Research {
  id             Int      @id @default(autoincrement())
  title          String
  description    String
  objective      String
  startDate      TimestamptzString @default(now())
  endDate        TimestamptzString @default(now())
  targetAudience String
  status         ResearchStatus   @default(DRAFT)
  companyId      Int
  company        Company  @relation(fields: [companyId], references: [id])
  sections       Section[]
  questionRules  QuestionRule[]
  researchers    ResearchResearcher[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model Section {
  id         Int      @id @default(autoincrement())
  title      String
  order      Int
  researchId Int
  research   Research   @relation(fields: [researchId], references: [id], onDelete: Cascade)
  questions  Question[]
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
}

model Question {
  id              Int              @id @default(autoincrement())
  statement       String
  type            QuestionType
  helpText        String?
  isRequired      Boolean          @default(false)
  order           Int
  sectionId       Int
  minSelections   Int?
  maxSelections   Int?
  minValue        Int?
  maxValue        Int?
  minDate         String?
  maxDate         String?
  maxLength       Int?
  scaleLeftLabel  String?
  scaleRightLabel String?
  maxFiles        Int?
  maxDuration     Int?
  section         Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options         QuestionOption[]
  answers         Answer[]
  sourceRules     QuestionRule[]   @relation("RuleSource")
  targetRules     QuestionRule[]   @relation("RuleTarget")
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model QuestionOption {
  id          Int      @id @default(autoincrement())
  text        String
  order       Int
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Answer {
  id          Int      @id @default(autoincrement())
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id])
  value       String
  createdAt   TimestamptzString @default(now())
}

model ResearchDownload {
  id         Int      @id @default(autoincrement())
  researchId Int
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  deviceId   String
  userId     Int?
  active     Boolean  @default(true)
  createdAt  TimestamptzString @default(now())
}

model ResearchResearcher {
  id         Int      @id @default(autoincrement())
  researchId Int
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  TimestamptzString @default(now())
}

model QuestionRule {
  id               Int      @id @default(autoincrement())
  researchId       Int
  research         Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  sourceQuestionId Int
  sourceQuestion   Question @relation("RuleSource", fields: [sourceQuestionId], references: [id], onDelete: Cascade)
  triggerValue     String
  targetQuestionId Int
  targetQuestion   Question @relation("RuleTarget", fields: [targetQuestionId], references: [id], onDelete: Cascade)
  createdAt        TimestamptzString @default(now())
}
