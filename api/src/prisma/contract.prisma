// use prisma-next

enum CompanySituation {
    ACTIVE
    INACTIVE
}

enum Profile {
  SUPERADMINISTRATOR
  ADMINISTRATOR
  RESEARCHER
}

enum ResearchStatus {
  DRAFT
  PUBLISHED
  IN_FIELD
  CLOSED
}

enum QuestionType {
  FREE_TEXT
  NUMERIC
  DATE
  TIME
  YES_NO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SCALE_1_5
  PHOTO
  MULTIPLE_PHOTOS
  LOCATION
  AUDIO
}

model Company {
  id                  Int      @id @default(autoincrement())
  legalName           String
  contactInformation  String
  situation           CompanySituation @default(ACTIVE)
  users               User[]
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  profile      Profile
  companyId    Int?
  company      Company?  @relation(fields: [companyId], references: [id])
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Research {
  id             Int      @id @default(autoincrement())
  title          String
  description    String
  objective      String
  startDate      TimestamptzString @default(now())
  endDate        TimestamptzString @default(now())
  targetAudience String
  status         ResearchStatus   @default(DRAFT)
  companyId      Int
  company        Company  @relation(fields: [companyId], references: [id])
  sections       Section[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model Section {
  id         Int      @id @default(autoincrement())
  title      String
  order      Int
  researchId Int
  research   Research   @relation(fields: [researchId], references: [id])
  questions  Question[]
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
}

model Question {
  id          Int          @id @default(autoincrement())
  statement   String
  type        QuestionType
  helpText    String?
  isRequired  Boolean      @default(false)
  order       Int
  sectionId   Int
  section     Section      @relation(fields: [sectionId], references: [id])
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}
