# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
JWT_SECRET=

# Cloudinary: onde ficam TODAS as fotos e áudios (arquivos privados, só a API os acessa).
# Pegue em Cloudinary > Dashboard > Go to API Keys. Use UMA das duas formas:
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ou, separado:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Pasta raiz no Cloudinary onde as mídias são guardadas (opcional). Cada pesquisa ganha uma subpasta própria:
# <CLOUDINARY_FOLDER>/<id da pesquisa>/... Se ficar vazio, não há pasta raiz (só <id da pesquisa>/...).
CLOUDINARY_FOLDER=

# Só para desenvolvimento SEM Cloudinary: pasta em disco (padrão: ./storage/audio)
AUDIO_STORAGE_DIR=
# Tamanho máximo do áudio de uma coleta, em bytes (padrão: 157286400 = 150 MB)
AUDIO_MAX_BYTES=
# Tamanho máximo de cada foto enviada à parte da coleta, em bytes (padrão: 31457280 = 30 MB)
PHOTO_MAX_BYTES=
